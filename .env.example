# Postgres connection string — paste yours here (in .env, not this file)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/grpc_one"
USER_SERVICE_PORT=50051
ORDER_SERVICE_PORT=50052
GATEWAY_PORT=3000

# Where each client finds the services it calls
USER_SERVICE_ADDR=localhost:50051
ORDER_SERVICE_ADDR=localhost:50052
